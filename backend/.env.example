DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend URLs allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173
# DATABASE_URL is only needed on Render (set automatically). Locally SQLite is used.

# Razorpay TEST keys (start with rzp_test_). Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed after deployment (see README)
RAZORPAY_WEBHOOK_SECRET=

# Google Sheets export
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
